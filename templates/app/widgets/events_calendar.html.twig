<div class="widget">
  <h3 class="section-title info"><a href="{{ path('article_events_list') }}">Kalendarz wydarzeń</a></h3>

  {% set time = "now"|date("U") %}
  {% set monthCalendar = get_month_calendar(time|date('Y'), time|date('m')) %}

  <table class="w-100">
    <thead>
    <tr>
      <th colspan="7" class="w-100 text-secondary pb-2">
        {{ time|date|format_datetime(pattern="LLLL yyyy") }}
      </th>
    </tr>
    <tr class="text-center">
      <th>Pn.</th>
      <th>Wt.</th>
      <th>Śr.</th>
      <th>Cz.</th>
      <th>Pt.</th>
      <th>Sb.</th>
      <th>Nd.</th>
    </tr>
    </thead>
    <tbody>
    <tr class="text-center">
      {% set startDow = time|date('F 1 Y')|date('N') - 1 %}
      {% set dow = startDow %}
      {% set today = time|date('j') %}

      {% for day in monthCalendar %}
      {% if loop.first and startDow != 0 %}
        <td colspan="{{ startDow }}"></td>
      {% endif %}

      {% set isToday = (today == day.day) %}
      {% set hasEvent = day.hasEvents %}
      {% set isHoliday = day.isHoliday %}
      {% set isSat = (dow == 5) %}
      {% set isSun = (dow == 6) %}

      {# Priorytet: dzisiaj (ciemna czerwień), wydarzenie (jaśniejsza czerwień), święto, niedziela, sobota #}
      {% if isToday %}
        {% set spanClass = 'fw-medium text-bg-primary' %}
        {% set spanStyle = '' %}
      {% elseif hasEvent %}
        {% set spanClass = 'fw-medium text-white' %}
        {% set spanStyle = 'background-color: #b84c4c;' %}
      {% elseif isHoliday %}
        {% set spanClass = 'bg-danger text-white' %}
        {% set spanStyle = '' %}
      {% elseif isSun %}
        {% set spanClass = 'text-danger' %}
        {% set spanStyle = '' %}
      {% elseif isSat %}
        {% set spanClass = 'text-muted' %}
        {% set spanStyle = '' %}
      {% else %}
        {% set spanClass = '' %}
        {% set spanStyle = '' %}
      {% endif %}

      <td class="py-1">
        {% if hasEvent %}
        <a href="{{ path('article_events_list_date', {date: day.date}) }}" class="text-decoration-none text-reset d-block">
        {% endif %}

          <span
            class="px-2 py-1 rounded-1 {{ spanClass }} position-relative d-inline-block"
            style="{{ spanStyle }}"
            {% if day.title != '' %}
              data-bs-toggle="tooltip" data-bs-title="{{ day.title }}"
            {% endif %}
          >
            {{ day.day }}
            {% if hasEvent %}
              {# Zielona kropka = w tym dniu jest wydarzenie #}
              <span
                class="position-absolute bottom-0 start-50 translate-middle-x rounded-pill"
                style="width: 6px; height: 6px; background-color: #198754; margin-bottom: 2px;"
              ></span>
            {% endif %}
          </span>

        {% if hasEvent %}
        </a>
        {% endif %}
      </td>
      {% if loop.last and dow != 6 %}
        <td colspan="{{ 6 - dow }}"></td>
      {% endif %}
      {% if dow == 6 %}
      {% set dow = 0 %}
    </tr>
    <tr class="text-center">
      {% else %}
        {% set dow = dow + 1 %}
      {% endif %}
      {% endfor %}
    </tr>
    </tbody>
  </table>

  <div class="d-flex justify-content-end mt-2">
    <a href="{{ path('article_events_list') }}" class="btn btn-sm btn-primary">
      Zobacz wszystkie
    </a>
  </div>
</div>
